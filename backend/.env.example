# Google OAuth credentials
# Get these from Google Cloud Console → APIs & Services → Credentials
GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=GOCSPX-your-google-client-secret

# OAuth callback URL
# Local:      http://localhost:8003/auth/callback
# Production: https://your-backend.railway.app/auth/callback
GOOGLE_REDIRECT_URI=http://localhost:8003/auth/callback

# Random secret key (used for signing tokens — generate any long random string)
SECRET_KEY=change-me-to-a-long-random-string

# Frontend URL (used for CORS)
# Local:      http://localhost:3000
# Production: https://your-app.vercel.app
FRONTEND_URL=http://localhost:3000

# OpenAI API key (fallback — teachers can also add their own key in Settings)
# Get from: https://platform.openai.com/api-keys
OPENAI_API_KEY=sk-your-openai-api-key
